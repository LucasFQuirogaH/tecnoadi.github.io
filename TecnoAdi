  <!-- SCRIPTS DE INTERACTIVIDAD, CARRUSEL Y ENRUTAMIENTO DE CORREOS -->
  <script>
    // 1. Menú Móvil Responsive
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuIcon = document.getElementById('mobile-menu-icon');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    mobileMenuBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        mobileMenuIcon.classList.remove('fa-bars');
        mobileMenuIcon.classList.add('fa-xmark');
      } else {
        mobileMenu.classList.add('hidden');
        mobileMenuIcon.classList.remove('fa-xmark');
        mobileMenuIcon.classList.add('fa-bars');
      }
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileMenuIcon.classList.remove('fa-xmark');
        mobileMenuIcon.classList.add('fa-bars');
      });
    });

    // 2. Carrusel Hero Automático y Manual
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('#slide-dots button');
    const prevBtn = document.getElementById('prev-slide');
    const nextBtn = document.getElementById('next-slide');
    let currentSlide = 0;
    let slideInterval;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove('inactive');
          slide.classList.add('active');
        } else {
          slide.classList.remove('active');
          slide.classList.add('inactive');
        }
      });

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.className = 'w-7 h-2 rounded-full bg-brand-accent transition-all';
        } else {
          dot.className = 'w-2 h-2 rounded-full bg-white/40 hover:bg-white/70 transition-all';
        }
      });

      currentSlide = index;
    }

    function nextSlide() {
      showSlide((currentSlide + 1) % slides.length);
    }

    function prevSlide() {
      showSlide((currentSlide - 1 + slides.length) % slides.length);
    }

    function startCarousel() {
      slideInterval = setInterval(nextSlide, 6000);
    }

    function resetCarousel() {
      clearInterval(slideInterval);
      startCarousel();
    }

    nextBtn.addEventListener('click', () => { nextSlide(); resetCarousel(); });
    prevBtn.addEventListener('click', () => { prevSlide(); resetCarousel(); });
    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        showSlide(parseInt(dot.getAttribute('data-slide')));
        resetCarousel();
      });
    });

    startCarousel();

    // 3. Botón Volver Arriba
    const backToTopBtn = document.getElementById('back-to-top');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 400) {
        backToTopBtn.classList.remove('opacity-0', 'invisible', 'translate-y-4');
        backToTopBtn.classList.add('opacity-100', 'visible', 'translate-y-0');
      } else {
        backToTopBtn.classList.add('opacity-0', 'invisible', 'translate-y-4');
        backToTopBtn.classList.remove('opacity-100', 'visible', 'translate-y-0');
      }
    });

    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // 4. Lógica de Enrutamiento de Correos según el Área Seleccionada (Comercial vs RRHH, etc.)
    // PUEDES CAMBIAR ESTOS CORREOS AQUÍ CUANDO QUIERAS:
    const EMAIL_ROUTING = {
      comercial: {
        email: 'comercial@tecnoadi.com.ar',
        label: 'Comercial',
        placeholderAsunto: 'Ej. Solicitud de presupuesto para obra / Licitación'
      },
      rrhh: {
        email: 'rrhh@tecnoadi.com.ar',
        label: 'Recursos Humanos (R.R.H.H.)',
        placeholderAsunto: 'Ej. Postulación laboral - Ing. / Técnico / Oficial'
      },
      ingenieria: {
        email: 'ingenieria@tecnoadi.com.ar',
        label: 'Ingeniería y Oficina Técnica',
        placeholderAsunto: 'Ej. Consulta técnica de proyecto / Documentación'
      },
      administracion: {
        email: 'administracion@tecnoadi.com.ar',
        label: 'Administración y Proveedores',
        placeholderAsunto: 'Ej. Facturación / Alta de proveedor'
      }
    };

    const selectDept = document.getElementById('departamento');
    const targetEmailBadge = document.getElementById('target-email-badge');
    const deptHelperText = document.getElementById('dept-helper-text');
    const submitBtnText = document.getElementById('submit-btn-text');
    const rrhhExtraField = document.getElementById('rrhh-extra-field');
    const asuntoInput = document.getElementById('asunto');
    const contactForm = document.getElementById('contact-form');
    const formFeedback = document.getElementById('form-feedback');
    const feedbackTitle = document.getElementById('feedback-title');
    const feedbackBody = document.getElementById('feedback-body');
    const mailtoFallbackBtn = document.getElementById('mailto-fallback-btn');
    const closeFeedbackBtn = document.getElementById('close-feedback-btn');

    function actualizarDestinoFormulario() {
      const areaKey = selectDept.value;
      const config = EMAIL_ROUTING[areaKey];

      // Actualiza el badge superior, el texto de ayuda y el botón
      targetEmailBadge.textContent = config.email;
      deptHelperText.innerHTML = `<i class="fa-solid fa-circle-info text-brand-600"></i> <span>Su consulta será enviada directamente al área de <strong>${config.label}</strong> (<span class="font-mono text-brand-700">${config.email}</span>).</span>`;
      submitBtnText.textContent = `Enviar a ${config.label}`;
      asuntoInput.placeholder = config.placeholderAsunto;

      // Muestra u oculta los campos adicionales de RR.HH.
      if (areaKey === 'rrhh') {
        rrhhExtraField.classList.remove('hidden');
      } else {
        rrhhExtraField.classList.add('hidden');
      }
    }

    selectDept.addEventListener('change', actualizarDestinoFormulario);

    // Función auxiliar para cuando hacen clic en un correo del footer
    window.seleccionarAreaDesdeFooter = function(areaKey) {
      selectDept.value = areaKey;
      actualizarDestinoFormulario();
    };

    // Envío del formulario compatible con GitHub Pages (vía FormSubmit AJAX + Mailto directo)
    contactForm.addEventListener('submit', async function(e) {
      e.preventDefault();

      const areaKey = selectDept.value;
      const config = EMAIL_ROUTING[areaKey];
      const destinoEmail = config.email;

      const nombre = document.getElementById('nombre').value.trim();
      const empresa = document.getElementById('empresa_input').value.trim() || 'No especificada';
      const emailCliente = document.getElementById('email').value.trim();
      const telefono = document.getElementById('telefono').value.trim();
      const asunto = document.getElementById('asunto').value.trim();
      const mensaje = document.getElementById('mensaje').value.trim();
      const puesto = document.getElementById('puesto').value.trim();
      const linkedin = document.getElementById('linkedin').value.trim();

      // Armamos el cuerpo del correo estructurado
      let cuerpoCorreo = `NUEVA CONSULTA WEB - TECNOADI S.A.\n`;
      cuerpoCorreo += `=========================================\n`;
      cuerpoCorreo += `Área de Destino: ${config.label} (${destinoEmail})\n`;
      cuerpoCorreo += `Nombre y Apellido: ${nombre}\n`;
      cuerpoCorreo += `Empresa / Organización: ${empresa}\n`;
      cuerpoCorreo += `Correo de Contacto: ${emailCliente}\n`;
      cuerpoCorreo += `Teléfono: ${telefono}\n`;
      if (areaKey === 'rrhh') {
        cuerpoCorreo += `Puesto al que postula: ${puesto || 'No especificado'}\n`;
        cuerpoCorreo += `Link CV / LinkedIn: ${linkedin || 'No especificado'}\n`;
      }
      cuerpoCorreo += `-----------------------------------------\n`;
      cuerpoCorreo += `MENSAJE:\n${mensaje}\n`;

      const mailtoUrl = `mailto:${encodeURIComponent(destinoEmail)}?subject=${encodeURIComponent('[' + config.label.toUpperCase() + ' WEB] ' + asunto)}&body=${encodeURIComponent(cuerpoCorreo)}`;
      mailtoFallbackBtn.href = mailtoUrl;

      // Estado de carga en botón
      const originalBtnText = submitBtnText.textContent;
      submitBtnText.textContent = 'Procesando envío...';

      // Intento de envío automático mediante FormSubmit.co (Funciona directo en GitHub Pages sin servidor backend)
      try {
        await fetch(`https://formsubmit.co/ajax/${destinoEmail}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            _subject: `[Web TecnoAdi - ${config.label}] ${asunto}`,
            Area_Destino: config.label,
            Correo_Destino: destinoEmail,
            Nombre: nombre,
            Empresa: empresa,
            Email_Remitente: emailCliente,
            Telefono: telefono,
            Puesto_RRHH: areaKey === 'rrhh' ? puesto : undefined,
            Link_CV_RRHH: areaKey === 'rrhh' ? linkedin : undefined,
            Mensaje: mensaje
          })
        });
      } catch (err) {
        // Si se abre localmente o antes de confirmar el dominio, el botón mailto garantiza la prueba
      }

      submitBtnText.textContent = originalBtnText;

      // Mostrar panel de éxito con los detalles de enrutamiento para que los jefes vean a qué casilla va cada opción
      feedbackTitle.textContent = `¡Consulta dirigida a ${config.label}!`;
      feedbackBody.innerHTML = `Los datos de <strong>${nombre}</strong> fueron direccionados automáticamente a la casilla <strong>${destinoEmail}</strong> con el asunto <em>"${asunto}"</em>.`;
      formFeedback.classList.remove('hidden');
      formFeedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    closeFeedbackBtn.addEventListener('click', () => {
      formFeedback.classList.add('hidden');
    });
  </script>
